# ════════════════════════════════════════════════════════════════════════════════
# gaet — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════════
#
# FILE:    ~/.gaet/.env
# PERMS:   chmod 600 ~/.gaet/.env  (owner read/write only)
# CREATED: gaet init  (wizard)  or  manual copy
#
# Usage:
#   1. Uncomment the lines you want to enable
#   2. Set your environment values
#   3. Do not commit this file to git (ignored in .gitignore)
#
# REQUIRED:     GAET_REMOTE_URL
# RECOMMENDED:  GAET_LOCAL_URL, GAET_LOCAL_DB_PASS
# OPTIONAL:     All other variables
#
# ════════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════════
# 1. LOCAL DATABASE  —  PostgreSQL database to back up
# ════════════════════════════════════════════════════════════════════════════════
#
# FORMAT 1 — Single line connection URL with password:
#   GAET_LOCAL_URL=postgresql://user:password@host:5432/dbname
#
#   ✅ Same format as GAET_REMOTE_URL. Easy copy-paste.
#   Example: GAET_LOCAL_URL=postgresql://postgres:secret@127.0.0.1:5432/mydb
#
# FORMAT 2 — Separate password variable (cleaner URL string, gaet init default):
#   GAET_LOCAL_URL=postgresql://user@host:5432/dbname
#   GAET_LOCAL_DB_PASS=password
#
#   💡 Password is hidden from the connection string.
#   Example: GAET_LOCAL_URL=postgresql://postgres@127.0.0.1:5432/mydb
#           GAET_LOCAL_DB_PASS=secret
#
# FORMAT 3 — Individual variables (backward compatible):
#   GAET_LOCAL_DB_HOST=127.0.0.1
#   GAET_LOCAL_DB_PORT=5432
#   GAET_LOCAL_DB_USER=postgres
#   GAET_LOCAL_DB_NAME=mydb
#   GAET_LOCAL_DB_PASS=password
#

# GAET_LOCAL_URL=postgresql://postgres@127.0.0.1:5432/database_name
# GAET_LOCAL_DB_PASS=


# ════════════════════════════════════════════════════════════════════════════════
# 2. CLOUD DATABASE  —  Target cloud PostgreSQL database (REQUIRED)
# ════════════════════════════════════════════════════════════════════════════════
#
# Format:   postgresql://user:password@host:5432/dbname
#
# Cloud providers:
#   Supabase: postgresql://postgres.xxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#   Neon:     postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   RDS:      postgresql://user:password@my-db.xxxxx.us-east-1.rds.amazonaws.com:5432/mydb
#   VPS:      postgresql://user:password@your-vps-ip:5432/mydb
#   Local:    postgresql://user:password@192.168.1.100:5432/mydb
#

# GAET_REMOTE_URL=postgresql://user:password@host:5432/database_name


# ════════════════════════════════════════════════════════════════════════════════
# 3. BACKUP & RETENTION
# ════════════════════════════════════════════════════════════════════════════════

# Number of days to keep backup snapshots before automated cleanup
# Backup files are stored in: ~/.gaet/backups/gaet_*.dump
# GAET_RETENTION_DAYS=7

# Automated backup interval in hours (used by `gaet push --auto`)
# Example: 6 = automatic backup every 6 hours (min: 1, max: 24)
# GAET_AUTO_INTERVAL=6

# Comma-separated list of tables to backup
# Default: Auto-detect all public schema tables
# GAET_TABLES=users,posts,comments,settings


# ════════════════════════════════════════════════════════════════════════════════
# 4. SSL / CONNECTION SECURITY
# ════════════════════════════════════════════════════════════════════════════════

# SSL mode for cloud database connections
#   require     = require SSL (default — for Supabase, Neon, RDS)
#   disable     = no SSL (local or internal network connections only)
#   verify-full = full certificate verification
# GAET_REMOTE_SSLMODE=require


# ════════════════════════════════════════════════════════════════════════════════
# 5. WEB DASHBOARD
# ════════════════════════════════════════════════════════════════════════════════

# Web dashboard port
# Access via browser: http://localhost:9191
# GAET_DASHBOARD_PORT=9191

# Host binding for web dashboard
#   0.0.0.0   = accessible from external network IP addresses
#   127.0.0.1 = localhost only (more secure)
# GAET_DASHBOARD_HOST=0.0.0.0

# Allowed CORS origin for dashboard API
# Default: http://localhost:9191
# DASHBOARD_ORIGIN=http://localhost:9191

# Path to gaet executable (used by background services)
# GAET_PATH=/home/user/.local/bin/gaet


# ════════════════════════════════════════════════════════════════════════════════
# 6. SERVICE / SCHEDULER
# ════════════════════════════════════════════════════════════════════════════════

# Prefix for system service names (systemd, launchd, Task Scheduler)
# GAET_SERVICE_PREFIX=gaet


# ════════════════════════════════════════════════════════════════════════════════
# 7. POSTGRESQL TOOLS PATH  (Optional — auto-detected if empty)
# ════════════════════════════════════════════════════════════════════════════════

# GAET_PG_DUMP=/usr/bin/pg_dump
# GAET_PG_RESTORE=/usr/bin/pg_restore
# GAET_PSQL=/usr/bin/psql


# ════════════════════════════════════════════════════════════════════════════════
# 8. PROJECT DIRECTORY  (Optional — dashboard path override)
# ════════════════════════════════════════════════════════════════════════════════

# GAET_PROJECT_DIR=/home/user/gaet


# ════════════════════════════════════════════════════════════════════════════════
# COMPLETE EXAMPLE
# ════════════════════════════════════════════════════════════════════════════════
#
# GAET_LOCAL_URL=postgresql://postgres@127.0.0.1:5432/production_db
# GAET_LOCAL_DB_PASS=s3cret
# GAET_REMOTE_URL=postgresql://postgres.abc123:password@aws-0.ap-southeast-1.pooler.supabase.com:6543/postgres
# GAET_RETENTION_DAYS=14
# GAET_AUTO_INTERVAL=4
# GAET_REMOTE_SSLMODE=require
# GAET_DASHBOARD_PORT=9191
# GAET_DASHBOARD_HOST=127.0.0.1
# GAET_TABLES=users,posts,comments,settings,audit_log


# ════════════════════════════════════════════════════════════════════════════════
# MINIMAL EXAMPLE
# ════════════════════════════════════════════════════════════════════════════════
#
# GAET_REMOTE_URL=postgresql://user:password@host:5432/db
